{
  "name": "security-headers-auditor",
  "version": "1.1.0",
  "description": "Microsoft Edge DevTools extension that audits HTTP security headers and provides actionable recommendations.",
  "author": "Security Headers Auditor Contributors",
  "license": "MIT",
  "scripts": {
    "lint": "eslint src/ devtools/",
    "format": "prettier --write \"**/*.{js,json,html,css,md}\"",
    "build": "node scripts/build.js",
    "package": "node scripts/package.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "@anthropic-ai/sdk": "^0.26.0",
    "@types/chrome": "^0.0.287"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Charlythegreat/Security-Headers-Auditor.git"
  },
  "keywords": [
    "edge-extension",
    "security-headers",
    "devtools",
    "csp",
    "hsts",
    "web-security",
    "browser-extension"
  ]
}
